<?xml version="1.0" encoding="UTF-8"?>
<!--
=======================================================
Trimitha - IIS Web.config Configuration
Purpose: Single 301 redirect to canonical URL
Final Destination: https://www.trimitha.co.in/
=======================================================
-->
<configuration>
    <system.webServer>
        
        <!-- ================================================
        REDIRECT TO HTTPS + WWW (Single 301)
        ================================================ -->
        
        <rewrite>
            <rules>
                <!-- HTTP → HTTPS (Single 301) -->
                <rule name="HTTP to HTTPS" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTPS}" pattern="off" />
                    </conditions>
                    <action type="Redirect" url="https://www.trimitha.co.in/{R:1}" redirectType="Permanent" />
                </rule>
                
                <!-- NON-WWW → WWW (Single 301) -->
                <rule name="Non-WWW to WWW" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTP_HOST}" pattern="^trimitha\.co\.in$" />
                    </conditions>
                    <action type="Redirect" url="https://www.trimitha.co.in/{R:1}" redirectType="Permanent" />
                </rule>
                
                <!-- Remove index.html -->
                <rule name="Remove index.html" stopProcessing="true">
                    <match url="(.*)/?index\.html?$" />
                    <action type="Redirect" url="{R:1}/" redirectType="Permanent" />
                </rule>
                
                <!-- Remove .html extension -->
                <rule name="Remove .html extension" stopProcessing="true">
                    <match url="^(.*)\.html$" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Redirect" url="{R:1}" redirectType="Permanent" />
                </rule>
                
                <!-- Remove trailing slash -->
                <rule name="Remove trailing slash" stopProcessing="true">
                    <match url="(.*)/$" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Redirect" url="{R:1}" redirectType="Permanent" />
                </rule>
            </rules>
        </rewrite>
        
        <!-- ================================================
        SECURITY HEADERS
        ================================================ -->
        
        <httpProtocol>
            <customHeaders>
                <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains; preload" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-XSS-Protection" value="1; mode=block" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
            </customHeaders>
        </httpProtocol>
        
        <!-- ================================================
        CACHE CONTROL
        ================================================ -->
        
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
            <mimeMap fileExtension=".html" mimeType="text/html" />
            <mimeMap fileExtension=".css" mimeType="text/css" />
            <mimeMap fileExtension=".js" mimeType="application/javascript" />
        </staticContent>
        
        <!-- ================================================
        COMPRESSION
        ================================================ -->
        
        <urlCompression doStaticCompression="true" doDynamicCompression="true" />
        
        <!-- ================================================
        ERROR DOCUMENTS
        ================================================ -->
        
        <httpErrors>
            <remove statusCode="404" />
            <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
        </httpErrors>
        
    </system.webServer>
</configuration>
